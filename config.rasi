* {
    font:   "MonaspiceAR Nerd Font 8";

    bg: #111111;
    fg: #ffffff;

    background-color: @bg;
    text-color:       @fg;
}

window {
    location: north;
    width: 100%;
    padding: 0px;
    border: 0;
}

mainbox {
    orientation: horizontal;
    children: [ inputbar ];
    text-color:       @fg;
    background-color: @bg;
}

inputbar {
    children: [ entry ];
    expand: true;
}

entry {
    width: 20em;
    padding: 4px 0px 4px 46%;
    text-color:       @fg;
    background-color: @bg;
}

listview {
    layout: horizontal;
    lines: 1;
    columns: 5;        /* number of suggestions visible */
    expand: true;
    fixed-height: true;
}

element {
    padding: 4px 6px;
}

element selected {
    background-color: rgba(255,255,255,0.1);
}* {
    bg: #111111;
    fg: #ffffff;

    background-color: @bg;
    text-color:       @fg;
}

